# Database Connection Configuration (MySQL / Hostinger)
# When these variables are set, the app will automatically connect to Hostinger MySQL
# instead of falling back to the local mock database JSON file.

DB_HOST=your-hostinger-mysql-host.hostinger.com
DB_PORT=3306
DB_USER=u123456789_user
DB_PASSWORD=your_hostinger_db_password
DB_NAME=u123456789_dbname

# Careers resume/CV email configuration
# Used by /api/careers/apply to email job applications with resume attachments.
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
MAIL_FROM="Orvion IntelliAct Website <no-reply@intelliactind.com>"
CAREERS_TO_EMAIL=Careers@intelliactind.com
